# ==================== LLM 配置 ====================
# OpenAI 兼容接口，支持 Qwen / DeepSeek 等

# API 基础地址
# Qwen: https://dashscope.aliyuncs.com/compatible-mode/v1
# DeepSeek: https://api.deepseek.com/v1
OPENAI_API_BASE=https://api.deepseek.com/v1

# API Key
OPENAI_API_KEY=your-api-key-here

# 默认模型 (Day 4-5 使用)
# Qwen: qwen-turbo, qwen-plus, qwen-max
# DeepSeek: deepseek-chat
OPENAI_MODEL=deepseek-chat

# ==================== Embedding 配置 ====================
# 嵌入模型
EMBEDDING_MODEL=text-embedding-3-small
# 本地嵌入模型 (可选，性能更好但需要下载)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==================== 向量数据库配置 ====================
# ChromaDB 持久化路径
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# ==================== 应用配置 ====================
# API 服务
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# CORS 允许的来源
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://localhost:8501"]

# ==================== 日志配置 ====================
LOG_LEVEL=INFO

# ==================== MCP Server ====================
MCP_HOST=0.0.0.0
MCP_PORT=8001
# 运行模式: local（直接调用服务层）/ http（通过 FastAPI API 调用）
MCP_MODE=local
MCP_API_BASE_URL=http://localhost:8000

# ==================== Agent 配置 ====================
# 使用 LangGraph 实现的 Agent (true) 或原始实现 (false)
USE_LANGGRAPH_AGENT=true

# ==================== Streamlit UI ====================
# 后端 API 地址 (Streamlit 使用)
# API_BASE_URL=http://localhost:8000
